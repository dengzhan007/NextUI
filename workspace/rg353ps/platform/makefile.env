# RG353PS BaseOS: mainline DRM/KMS + Mesa Panfrost, no vendor Mali framebuffer.
OPT = -O3 -fomit-frame-pointer
CFLAGS = -mcpu=cortex-a55
SDL = SDL2
GL = GLES

CFLAGS += -I$(PREFIX_LOCAL)/include -I$(PREFIX)/include
LDFLAGS = -L$(PREFIX_LOCAL)/lib -L$(PREFIX)/lib
CFLAGS += $(shell pkg-config --cflags sdl2 SDL2_image SDL2_ttf glesv2)
LDFLAGS += $(shell pkg-config --libs sdl2 SDL2_image SDL2_ttf glesv2)
CFLAGS += -DUSE_$(SDL) -DUSE_$(GL) -DGL_GLEXT_PROTOTYPES
LDFLAGS += -lpthread -ldl -lm -lz -lsamplerate
